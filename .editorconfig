# is a top-most file
root = true

#[*]
#charset = utf-8
#indent_style = space
#indent_size = 4
#end_of_line = lf
#insert_final_newline = true
#trim_trailing_whitespace = true

[*.{md,mkdn}]
indent_size = 2
trim_trailing_whitespace = true
indent_style = space

[*.{yml,yaml}]
indent_size = 2
trim_trailing_whitespace = true
indent_style = space
